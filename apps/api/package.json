{
  "name": "@marketverse/api",
  "version": "1.0.0",
  "private": true,
  "description": "MarketVerse backend API for Indian equity market intelligence.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/mcp",
    "test:integration": "vitest run tests/integration",
    "test:live": "LIVE_NSE_TESTS=1 vitest run tests/live",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:reset-test": "tsx scripts/reset-test-db.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "nse:inspect": "tsx scripts/nse-inspect.ts",
    "nse:test": "tsx scripts/nse-test.ts"
  },
  "dependencies": {
    "@marketverse/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
