# ---------------------------------------------------------------------------
# MarketVerse API — local environment template.
# Copy to `.env` (or `.env.local` for developer overrides) and adjust.
# Never commit real credentials.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# Homebrew Postgres: user is your macOS user and there is no password by default.
DATABASE_URL=postgresql://localhost:5432/marketverse
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- HTTP security ----------------------------------------------------------
# Comma separated list of allowed origins. Empty = same-origin / non-browser clients only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
REQUEST_BODY_LIMIT=1mb

# Optional shared secret. When set, mutation endpoints require `x-api-key`.
API_KEY=

# --- NSE MCP ----------------------------------------------------------------
# Official NSE Model Context Protocol servers (Streamable HTTP, no auth).
NSE_MCP_ENABLED=true
NSE_BHAVCOPY_MCP_URL=https://mcp.nseindia.in/bhavcopy/cm/mcp
NSE_MARKET_MCP_URL=https://mcp.nseindia.in/cmmkt/mcp
NSE_MCP_TIMEOUT_MS=20000
NSE_MCP_MAX_RETRIES=2
# Cache discovered tool catalogues on disk (schema drift detection).
NSE_TOOL_CACHE_TTL_MS=21600000
NSE_ALLOW_RAW_RESPONSE_STORAGE=true

# --- Market data ------------------------------------------------------------
MARKET_TIMEZONE=Asia/Kolkata
CACHE_TTL_QUOTE_SECONDS=60
CACHE_TTL_HISTORY_SECONDS=900
CACHE_TTL_MARKET_SECONDS=60
QUOTE_STALE_AFTER_SECONDS=600
HISTORY_STALE_AFTER_HOURS=30

# --- AI infrastructure ------------------------------------------------------
# Comma separated configurable watchlist. Empty = use documented defaults.
AI_INFRA_WATCHLIST_SYMBOLS=TDPOWERSYS,THERMAX,NETWEB,HFCL,CGPOWER,POWERINDIA,STLTECH,AEROFLEX,KRN

# --- Portfolio benchmarks ---------------------------------------------------
BENCHMARK_INDEX_SYMBOL=NIFTY 50
BENCHMARK_FD_ANNUAL_RATE=0.08

# --- Scheduled jobs ---------------------------------------------------------
JOBS_ENABLED=false
JOB_MARKET_REFRESH_CRON=*/5 9-16 * * 1-5
JOB_HISTORY_SYNC_CRON=30 18 * * 1-5
JOB_INDICATORS_CRON=0 19 * * 1-5
JOB_SCORES_CRON=15 19 * * 1-5
JOB_ALERTS_CRON=*/10 9-16 * * 1-5
JOB_NEWS_CRON=0 */2 * * *
JOB_DATA_QUALITY_CRON=45 19 * * 1-5

# --- Live diagnostics -------------------------------------------------------
# Set to 1 to let the optional live NSE integration test run.
LIVE_NSE_TESTS=0
